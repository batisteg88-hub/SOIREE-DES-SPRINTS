
{
  "entities": {
    "Athlete": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Athlete",
      "type": "object",
      "description": "Représente un nageur avec ses données de performance et son profil CSS.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string", "enum": ["NV1", "NV1+", "NV2", "N3", "N4", "N1"] },
        "gender": { "type": "string", "enum": ["M", "F"] },
        "birthYear": { "type": "number" },
        "evaluator": { "type": "string" },
        "cssPace": { "type": "number" },
        "cssSpeed": { "type": "number" },
        "awc": { "type": "number" },
        "isProvisional": { "type": "boolean" },
        "skills": { 
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "required": ["name", "ownerId"]
    },
    "Performance": {
      "title": "Performance",
      "type": "object",
      "properties": {
        "distance": { "type": "number" },
        "timeInSeconds": { "type": "number" },
        "date": { "type": "object" }
      },
      "required": ["distance", "timeInSeconds", "date"]
    },
    "Workout": {
      "title": "Workout",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "object" },
        "group": { "type": "string" },
        "blocks": { "type": "array" },
        "isCycleSession": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "summary": { "type": "object" }
      },
      "required": ["title", "date"]
    },
    "Attendance": {
      "title": "Attendance",
      "type": "object",
      "properties": {
        "date": { "type": "object" },
        "presences": { 
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["present", "absent"] }
        }
      },
      "required": ["date", "presences"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/users/{userId}/athletes/{athleteId}": {
      "schema": { "$ref": "#/backend/entities/Athlete" },
      "description": "Profils des nageurs."
    },
    "/users/{userId}/athletes/{athleteId}/performances/{perfId}": {
      "schema": { "$ref": "#/backend/entities/Performance" },
      "description": "Tests chronométrés pour chaque nageur."
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": { "$ref": "#/backend/entities/Workout" },
      "description": "Séances d'entraînement planifiées et réalisées."
    },
    "/users/{userId}/attendances/{attendanceId}": {
      "schema": { "$ref": "#/backend/entities/Attendance" },
      "description": "Feuilles d'émargement quotidiennes."
    }
  }
}
